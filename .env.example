NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local preview only. Never enable this on a public deployment.
ALLOW_LOCAL_PREVIEW=false
# Vertex AI is the only AI transport. Local: gcloud auth application-default login.
GOOGLE_VERTEX_PROJECT=orbiter-ai
GOOGLE_VERTEX_LOCATION=global
VERTEX_AUTH_MODE=adc
# Choose exact Vertex model IDs available to this project; no automatic model fallback.
VERTEX_GEMINI_MODEL=
VERTEX_CLAUDE_MODEL=
VERTEX_SEARCH_MODEL=
# Vercel Production: use wif and values printed by scripts/setup-vertex-gcp.sh.
GOOGLE_VERTEX_WIF_PROVIDER=
GOOGLE_VERTEX_SERVICE_ACCOUNT=
# Optional encryption for browser model preferences only (32+ random characters).
# If omitted, a purpose-separated key derives from SUPABASE_SERVICE_ROLE_KEY.
AI_CREDENTIAL_SECRET=
# Daily offsite backup: Google Drive free space by default. Production only.
BACKUP_STORAGE_PROVIDER=google-drive
BACKUP_GOOGLE_CLIENT_ID=
BACKUP_GOOGLE_CLIENT_SECRET=
BACKUP_GOOGLE_REFRESH_TOKEN=
# Shared backup settings. S3/R2 variables are optional when using Google Drive.
SUPABASE_SERVICE_ROLE_KEY=
BACKUP_AUTHOR_ID=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=kosmos
CRON_SECRET=
# Optional missing-run monitor. Set its check to 24h period + 12h grace and connect notifications.
BACKUP_HEALTHCHECK_URL=
